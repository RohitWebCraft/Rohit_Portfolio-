      when: "Sep 2026",
      desc: "An English vocabulary quiz organised by chapter, with Hindi meanings and example sentences.",
      tags: ["Vocabulary", "Hindi meanings", "Chapter-wise"],
      url: "https://rohitwebcraft.github.io/MFE-QUIZZ-FEA/"
    }
  ],

  experience: [
    {
      when: "2026 – Present",
      title: "Master Teacher",
      org: "Freedom Employability Academy (FEA), Panna",
      points: [
        "Promoted to Master Teacher shortly after completing the Master Teachers Program: Foundation, Part 1 (May 2026).",
        "Teach learners aged 18+ in English, Digital Literacy and Core Employability Skills at the Mahewa Centre.",
        "Plan lesson activities, practice materials and speaking tasks, and build quizzes and games for the classroom.",
        "Keep attendance records and follow up with learners through calls and home visits to support retention."
      ]
    },
    {
      when: "2025 – 2026",
      title: "Teacher",
      org: "Freedom Employability Academy (FEA), Panna",
      points: [
        "Moved from Facilitator to Teacher after about six months at FEA.",
        "Taught English, Digital Literacy and Core Employability Skills at the Itwan Kalan Centre until Sep 2025, then at the Mahewa Centre from Oct 2025."
      ]
    },
    {
      when: "Nov 2024 – 2025",
      title: "Facilitator",
      org: "Freedom Employability Academy (FEA), Panna",
      points: [
        "Joined FEA as a Facilitator on 25 Nov 2024, after completing the 53-day Staff Training Program.",
        "Started at the Itwan Kalan Centre, teaching learners aged 18+."
      ]
    }
  ],

  education: [
    { year: "2023", title: "B.Ed.", place: "Maharaja Chhatrasal Bundelkhand University, Chhatarpur", result: "Result: 66.33%" },
    { year: "2022", title: "PGDCA", place: "Makhanlal Chaturvedi University, Bhopal", result: "Result: 72%" },
    { year: "2021", title: "B.Sc. Computer Science", place: "Avdhesh Pratap Singh University, Rewa", result: "Result: 61.21%" }
  ],

  training: [
    { title: "Master Teachers Program: Foundation, Part 1", meta: "4–9 May 2026, 6 days" },
    { title: "Master Teachers Intensive English Training", meta: "20–25 Apr 2026, 6 days" },
    { title: "Students Retention Training", meta: "5–10 Jan 2026, 6 days" },
    { title: "Lesson Preparedness with AI NotebookLM and ChatGPT", meta: "18 Jul 2025, online" },
    { title: "FEA Staff Training Program", meta: "Completed 8 Oct 2024, 53 days" }
  ],

  skills: [
    "Teaching and classroom facilitation",
    "English communication",
    "Digital literacy and basic computer",
    "Lesson planning and learning materials",
    "Classroom management",
    "SBI feedback and mentoring",
    "MS Office",
    "Quiz and web app development",
    "Google Sheets and Apps Script"
  ]
};
/* ================================================== */

const $ = s => document.querySelector(s);
const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; };
const anim = document.documentElement.classList.contains("anim");
const stagger = (node, i, step) => node.style.setProperty("--d", (i * step).toFixed(2) + "s");

/* ---------- static text ---------- */
document.title = CONFIG.name + " (" + CONFIG.brand + ") | Master Teacher and Learning-Game Builder";
$("#brand").textContent = CONFIG.brand;
$("#lead").textContent = CONFIG.summary;
$("#where").textContent = CONFIG.place;
$("#foot").textContent = "© " + new Date().getFullYear() + " " + CONFIG.name + " (" + CONFIG.brand + "). " + CONFIG.place + ".";

/* ---------- hero name: letters rise one by one ---------- */
(function () {
  const h = $("#name");
  h.setAttribute("aria-label", CONFIG.name);
  const words = CONFIG.name.split(" ");
  let i = 0;
  words.forEach((word, wi) => {
    const w = el("span", "w");
    w.setAttribute("aria-hidden", "true");
    [...word].forEach(chr => { const s = el("span", "ch", chr); s.style.setProperty("--i", i++); w.append(s); });
    h.append(w);
    if (wi < words.length - 1) h.append(document.createTextNode(" "));
  });
})();

/* ---------- role typewriter ---------- */
(function () {
  const out = $("#role");
  if (!anim) { out.textContent = CONFIG.roles.slice(0, 3).join(" | "); $("#caret").hidden = true; return; }
  let r = 0, c = 0, del = false;
  (function tick() {
    const word = CONFIG.roles[r];
    c += del ? -1 : 1;
    out.textContent = word.slice(0, c);
    let t = del ? 35 : 75;
    if (!del && c === word.length) { t = 1700; del = true; }
    else if (del && c === 0) { del = false; r = (r + 1) % CONFIG.roles.length; t = 350; }
    setTimeout(tick, t);
  })();
})();

/* ---------- stats ---------- */
CONFIG.stats.forEach((s, i) => {
  const li = el("li", "rv");
  stagger(li, i, .12);
  const b = el("b", "", (anim ? 0 : s.n) + s.suffix);
  b.dataset.n = s.n; b.dataset.suffix = s.suffix;
  li.append(b, el("span", "", s.label));
  $("#stats").append(li);
});

/* ---------- projects ---------- */
CONFIG.projects.forEach((p, i) => {
  const li = el("li", "rv");
  stagger(li, i, .12);
  const card = el("article", "card");
  const meta = el("div", "meta");
  meta.append(el("span", "", p.when));
  if (p.url) { const live = el("span", "live"); live.append(el("i"), document.createTextNode("Live")); meta.append(live); }
  card.append(el("h3", "", p.title), meta, el("p", "", p.desc));
  const tags = el("ul", "tags");
  p.tags.forEach(t => tags.append(el("li", "", t)));
  card.append(tags);
  if (p.url) {
    const foot = el("div", "foot");
    const a = el("a", "btn small", "Open project");
    a.href = p.url; a.target = "_blank"; a.rel = "noopener";
    a.setAttribute("aria-label", "Open " + p.title);
    foot.append(a); card.append(foot);
  }
  li.append(card);
  $("#projects").append(li);
});

/* ---------- experience ---------- */
CONFIG.experience.forEach(x => {
  const li = el("li", "rv");
  const dot = el("span", "dot"); dot.setAttribute("aria-hidden", "true");
  li.append(dot, el("div", "when", x.when), el("h3", "", x.title));
  if (x.org) li.append(el("p", "org", x.org));
  const ul = el("ul", "points");
  x.points.forEach(t => ul.append(el("li", "", t)));
  li.append(ul);
  $("#experience").append(li);
});

/* ---------- education, training, skills ---------- */
CONFIG.education.forEach((e, i) => {
  const li = el("li", "rv"); stagger(li, i, .1);
  const c = el("div", "edu-card");
  c.append(el("div", "yr", e.year), el("strong", "", e.title), el("span", "", e.place), el("span", "", e.result));
  li.append(c); $("#edu").append(li);
});
CONFIG.training.forEach((t, i) => {
  const li = el("li", "rv"); stagger(li, i % 2, .1);
  const c = el("div", "edu-card");
  c.append(el("strong", "", t.title), el("span", "", t.meta));
  if (t.desc) c.append(el("p", "", t.desc));
  li.append(c); $("#training").append(li);
});
CONFIG.skills.forEach((s, i) => {
  const li = el("li", "rv", s); stagger(li, i, .05);
  $("#skills").append(li);
});

/* ---------- contact ---------- */
(function () {
  const box = $("#contact-actions");
  const wa = (CONFIG.phone || "").replace(/\D/g, "");
  const add = (cls, text, href, external) => {
    const a = el("a", cls, text); a.href = href;
    if (external) { a.target = "_blank"; a.rel = "noopener"; }
    box.append(a);
  };
  if (wa) {
    add("btn primary", "Message on WhatsApp", "https://wa.me/" + wa + "?text=" + encodeURIComponent("Hello Sir, I would like to talk about a quiz project."), true);
    add("btn", "Call " + (CONFIG.phoneShow || ("+" + wa)), "tel:+" + wa);
  }
  if (CONFIG.email) add("btn", "Email me", "mailto:" + CONFIG.email);
  if (CONFIG.github) add("btn", "GitHub", CONFIG.github, true);
})();

/* ---------- sample quiz ---------- */
const QUIZ = [
  { en: "He ___ to school every day.", hi: "वह रोज़ स्कूल जाता है।", opts: ["go", "goes", "going", "gone"], a: 1,
    why: "With he, she and it, the present-tense verb takes -s or -es: goes." },
  { en: "I ___ a new book.", hi: "मेरे पास एक नई किताब है।", opts: ["has", "had", "having", "have"], a: 3,
    why: "Use have with I, you, we and they. Has is only for he, she and it." },
  { en: "Which word means hard-working?", hi: "'मेहनती' के लिए सही English word कौन सा है?", opts: ["Careless", "Fragile", "Diligent", "Generous"], a: 2,
    why: "Diligent means working carefully and with steady effort." }
];
let qi = 0, score = 0, locked = false, soundOn = true, actx;

function beep(ok) {
  if (!soundOn) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    const t = actx.currentTime;
    (ok ? [[660, 0], [880, .12]] : [[220, 0], [170, .14]]).forEach(([f, d]) => {
      const o = actx.createOscillator(), g = actx.createGain();
      o.type = ok ? "sine" : "sawtooth";
      o.frequency.value = f;
      g.gain.setValueAtTime(.0001, t + d);
      g.gain.exponentialRampToValueAtTime(.15, t + d + .02);
      g.gain.exponentialRampToValueAtTime(.0001, t + d + .2);
      o.connect(g).connect(actx.destination);
      o.start(t + d); o.stop(t + d + .22);
    });
  } catch (e) { /* audio unavailable */ }
}

function render() {
  const q = QUIZ[qi];
  $("#qnum").textContent = "Question " + (qi + 1) + " of " + QUIZ.length;
  $("#score").textContent = "Score: " + score;
  $("#qbar").style.width = (qi / QUIZ.length * 100) + "%";
  $("#qen").textContent = q.en;
  $("#qhi").textContent = q.hi;
  const box = $("#opts");
  box.replaceChildren();
  q.opts.forEach((t, k) => {
    const b = el("button", "opt", t);
    b.type = "button"; b.style.setProperty("--k", k);
    b.addEventListener("click", () => pick(k, b));
    box.append(b);
  });
  $("#explain").textContent = "";
  $("#next").hidden = true;
  locked = false;
}

function pick(k, btn) {
  if (locked) return;
  locked = true;
  const q = QUIZ[qi];
  const btns = [...document.querySelectorAll(".opt")];
  btns.forEach(b => (b.disabled = true));
  if (k === q.a) {
    score++; btn.classList.add("good");
    $("#explain").textContent = "Correct. " + q.why;
    beep(true);
  } else {
    btn.classList.add("bad"); btns[q.a].classList.add("good");
    $("#explain").textContent = "Not quite. " + q.why;
    beep(false);
  }
  $("#score").textContent = "Score: " + score;
  const next = $("#next");
  next.textContent = qi === QUIZ.length - 1 ? "See result" : "Next question";
  next.hidden = false;
  next.focus();
}

$("#next").addEventListener("click", () => {
  if (qi < QUIZ.length - 1) { qi++; render(); return; }
  $("#qbar").style.width = "100%";
  $("#play").hidden = true;
  $("#result").hidden = false;
  $("#rtitle").textContent = "You got " + score + " of " + QUIZ.length + " right.";
  $("#again").focus();
});
$("#again").addEventListener("click", () => {
  qi = 0; score = 0;
  $("#result").hidden = true; $("#play").hidden = false;
  render();
});
$("#sound").addEventListener("click", e => {
  soundOn = !soundOn;
  e.currentTarget.textContent = "Sound: " + (soundOn ? "on" : "off");
  e.currentTarget.setAttribute("aria-pressed", String(soundOn));
});
render();

/* ---------- motion ---------- */
function countUp(n) {
  const to = +n.dataset.n, suf = n.dataset.suffix || "", t0 = performance.now(), dur = 1500;
  (function f(t) {
    const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
    n.textContent = Math.round(to * e) + suf;
    if (k < 1) requestAnimationFrame(f);
  })(t0);
}

(function motion() {
  const rv = [...document.querySelectorAll(".rv")];
  const counters = [...document.querySelectorAll("[data-n]")];
  if (!anim || !("IntersectionObserver" in window)) {
    rv.forEach(n => n.classList.add("in"));
    counters.forEach(n => (n.textContent = n.dataset.n + (n.dataset.suffix || "")));
  } else {
    const io = new IntersectionObserver(es => {
      es.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { threshold: .12, rootMargin: "0px 0px -6% 0px" });
    rv.forEach(n => io.observe(n));
    const cio = new IntersectionObserver(es => {
      es.forEach(e => { if (e.isIntersecting) { countUp(e.target); cio.unobserve(e.target); } });
    }, { threshold: .6 });
    counters.forEach(n => cio.observe(n));
  }

  /* active nav link */
  const links = [...document.querySelectorAll(".bar nav a")];
  if ("IntersectionObserver" in window) {
    const so = new IntersectionObserver(es => {
      es.forEach(e => {
        if (!e.isIntersecting) return;
        links.forEach(a => a.removeAttribute("aria-current"));
        const a = links.find(l => l.getAttribute("href") === "#" + e.target.id);
        if (a) a.setAttribute("aria-current", "true");
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    links.forEach(a => { const s = document.querySelector(a.getAttribute("href")); if (s) so.observe(s); });
  }

  /* scroll progress + timeline line */
  const bar = $("#progress"), tl = $("#experience");
  let queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = "scaleX(" + (max > 0 ? Math.min(1, scrollY / max) : 0) + ")";
      if (anim) {
        const r = tl.getBoundingClientRect();
        tl.style.setProperty("--p", Math.max(0, Math.min(1, (innerHeight * .6 - r.top) / r.height)));
      }
    });
  }
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  onScroll();

  /* card glow + tilt (mouse only) */
  if (matchMedia("(hover:hover)").matches) {
    document.querySelectorAll(".card").forEach(card => {
      card.addEventListener("pointermove", e => {
        if (e.pointerType !== "mouse") return;
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        card.style.setProperty("--mx", (px * 100) + "%");
        card.style.setProperty("--my", (py * 100) + "%");
        if (anim) {
          card.style.setProperty("--ry", ((px - .5) * 5) + "deg");
          card.style.setProperty("--rx", ((.5 - py) * 5) + "deg");
        }
      });
      card.addEventListener("pointerleave", () => {
        card.style.setProperty("--rx", "0deg");
        card.style.setProperty("--ry", "0deg");
      });
    });
  }

  /* drifting chalk dust */
  if (anim) {
    const cv = $("#dust"), cx = cv.getContext("2d"), dpr = Math.min(devicePixelRatio || 1, 2);
    let w = 0, h = 0, dots = [];
    function size() {
      if (innerWidth === w && Math.abs(innerHeight - h) < 140) return;
      w = innerWidth; h = innerHeight;
      cv.width = w * dpr; cv.height = h * dpr;
      cv.style.width = w + "px"; cv.style.height = h + "px";
      cx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(60, w * h / 26000));
      dots = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.6 + .4, s: Math.random() * .25 + .08, a: Math.random() * .3 + .08, p: Math.random() * 6.28 }));
    }
    size();
    addEventListener("resize", size);
    (function frame(t) {
      cx.clearRect(0, 0, w, h);
      cx.fillStyle = "#f2efe4";
      for (const d of dots) {
        d.y -= d.s; d.x += Math.sin(t / 2000 + d.p) * .12;
        if (d.y < -5) { d.y = h + 5; d.x = Math.random() * w; }
        cx.globalAlpha = d.a;
        cx.beginPath(); cx.arc(d.x, d.y, d.r, 0, 6.283); cx.fill();
      }
      requestAnimationFrame(frame);
    })(0);
  }
})();
</script>
</body>
</html>
